# Google Gemini AI Key for Aegis Copilot Chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (PostgreSQL) Cloud Database Configuration
# (If omitted or empty, AegisGuard seamlessly uses the local SQLite database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Anthropic Claude 3.5 Sonnet Key (Optional fallback available)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Port & SQLite Path
PORT=5000
DATABASE_PATH=./data/app.db
